# Baseline: let git detect text and normalize to LF in the repository.
# This line predates the Redo branch — keep it so existing files are not renormalized.
* text=auto

# ---------------------------------------------------------------
# Unity serialized assets
# Force Text serialization is enabled (EditorSettings m_SerializationMode: 2),
# so these are YAML and must stay text for diffs to be readable.
# ---------------------------------------------------------------
*.unity      text
*.prefab     text
*.asset      text
*.mat        text
*.anim       text
*.controller text
*.overrideController text
*.physicMaterial     text
*.physicsMaterial2D  text
*.playable   text
*.mask       text
*.brush      text
*.flare      text
*.fontsettings text
*.guiskin    text
*.giparams   text
*.lighting   text
*.meta       text
*.mixer      text
*.preset     text
*.renderTexture text
*.shadervariants text
*.spriteatlas   text
*.terrainlayer  text
*.signal     text
*.asmdef     text
*.asmref     text
*.inputactions text

# ---------------------------------------------------------------
# Source and config
# ---------------------------------------------------------------
*.cs      text diff=csharp
*.shader  text
*.cginc   text
*.hlsl    text
*.compute text
*.json    text
*.md      text
*.txt     text
*.xml     text
*.yml     text
*.yaml    text

# ---------------------------------------------------------------
